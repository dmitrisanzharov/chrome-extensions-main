{
   "name": "aaa_Rev3_extension",
   "version": "1.0",
   "description": "Extension Revision 3",
   "manifest_version": 3,
   "permissions": [
       "tabs",
       "activeTab",
       "storage",
       "scripting",
       "contextMenus",
       "notifications",
       "alarms"
   ],
   "background": {
       "service_worker": "background.js"
   },
   "content_scripts": [
       {
           "matches": ["<all_urls>"],
           "js": ["content.js"]
       }
   ],
   "action": {
       "default_popup": "popup.html"
   }
}

{
    "name": "aaa_Dimi_Extension",
    "version": "1.0",
    "description": "Sparta extension",
    "manifest_version": 3,
    "permissions": ["tabs", "activeTab", "storage", "scripting", "contextMenus", "notifications", "alarms"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "web_accessible_resources": [
        {
            "resources": ["assets/*"],
            "matches": ["<all_urls>"]
        }
    ]
}

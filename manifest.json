{
    "name": "aaa_Rev_4",
    "version": "0.0.1",
    "description": "Dmitri Ext Rev 4",
    "manifest_version": 3,
    "permissions": ["tabs", "activeTab", "scripting", "storage"],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["assets/*"],
            "matches": ["<all_urls>"]
        }
    ],
    "icons": {
        "16": "assets/free.png",
        "48": "assets/free.png",
        "128": "assets/free.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Dmitri Ext from Actions"
    }
}

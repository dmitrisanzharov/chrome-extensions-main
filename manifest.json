{
    "name": "aaa_Rev_4",
    "version": "0.0.1",
    "description": "Dmitri Ext Rev 4",
    "manifest_version": 3,
    "permissions": ["tabs", "activeTab", "scripting", "storage"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    }
}
